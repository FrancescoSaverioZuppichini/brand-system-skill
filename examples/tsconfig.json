{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "Preserve",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"types": ["bun", "vite/client"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "scripts", "vite.config.ts"]
}
